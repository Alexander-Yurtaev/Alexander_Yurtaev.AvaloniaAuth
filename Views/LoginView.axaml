<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="using:Alexander_Yurtaev.AvaloniaAuth.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Alexander_Yurtaev.AvaloniaAuth.Views.LoginView"
             x:DataType="viewmodels:LoginViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Classes="auth-state">
        <Border Grid.Row="0">
            <Grid RowDefinitions="Auto,Auto"
                  IsEnabled="{Binding !LoginCommand.IsRunning}">
                <StackPanel Grid.Row="0"
                            Classes="field">
                    <Label Content="Email"
                           Target="EmailTextBox"/>
                    <TextBox x:Name="EmailTextBox"
                             Text="{Binding Email}"/>
                </StackPanel>
                <StackPanel Grid.Row="1"
                            Classes="field">
                    <Label Content="Пароль"
                           Target="PasswordTextBox"/>
                    <TextBox x:Name="PasswordTextBox"
                             Text="{Binding Password}"
                             PasswordChar="*"/>
                </StackPanel>
            </Grid>
        </Border>
        <Button Grid.Row="1"
                Content="Login"
                Command="{Binding LoginCommand}"
                Classes="primary"/>

        <Border Grid.Row="3"
                Classes="auth-footer">
            <Button Content="btn__RegView"
                    Command="{Binding RegisterCommand}"/>
        </Border>
    </Grid>
</UserControl>