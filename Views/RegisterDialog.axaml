<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="using:Alexander_Yurtaev.AvaloniaAuth.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800"
        x:Class="Alexander_Yurtaev.AvaloniaAuth.Views.RegisterDialog"
        x:DataType="viewmodels:RegisterDialogViewModel"
        Title="Регистрация"
        x:Name="RegisterDlg">

    <Grid RowDefinitions="*,Auto">
        <Border Grid.Row="0"
                Classes="modal-body"
                IsEnabled="{Binding !RegisterCommand.IsRunning}">
            <Grid RowDefinitions="Auto,Auto,Auto">
                <StackPanel Classes="field"
                            Grid.Row="0">
                    <Label Content="Email"
                           Target="EmailTextBox"/>
                    <TextBox x:Name="EmailTextBox"
                             Text="{Binding Email}"/>
                </StackPanel>
                <StackPanel Grid.Row="1"
                            Classes="field">
                    <Label Content="Имя"
                           Target="NameTextBox"/>
                    <TextBox x:Name="NameTextBox"
                             Text="{Binding Name}"/>
                </StackPanel>
                <StackPanel Grid.Row="2"
                            Classes="field">
                    <Label Content="Пароль"
                           Target="PasswordTextBox"/>
                    <TextBox x:Name="PasswordTextBox"
                             Text="{Binding Password}"
                             PasswordChar="*"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="2"
                Classes="modal-footer">
            <StackPanel Classes="modal-footer">
                <Button Content="Закрыть"
                        Command="{Binding CloseCommand}"
                        IsVisible="{Binding !RegisterCommand.IsRunning}"/>
                <Button Content="Отмена"
                        Command="{Binding CancelCommand}"
                        IsVisible="{Binding RegisterCommand.IsRunning}"/>
                <Button Content="Зарегистрироваться"
                        Command="{Binding RegisterCommand}"
                        Classes="primary"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>