<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="using:Alexander_Yurtaev.AvaloniaAuth.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800"
        x:Class="Alexander_Yurtaev.AvaloniaAuth.Views.RegisterDialog"
        x:DataType="viewmodels:RegisterDialogViewModel"
        Title="Регистрация"
        x:Name="RegisterDlg">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Classes="modal-body">
            <Grid RowDefinitions="Auto,Auto,Auto">
                <StackPanel Classes="field"
                            Grid.Row="0">
                    <Label Content="Email"
                           Target="EmailTextBox"/>
                    <TextBox x:Name="EmailTextBox"
                             Text="{Binding Email}"/>
                </StackPanel>
                <StackPanel Grid.Row="1"
                            Classes="field">
                    <Label Content="Имя"
                           Target="NameTextBox"/>
                    <TextBox x:Name="NameTextBox"
                             Text="{Binding Name}"/>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Label Content="Пароль"
                           Target="PasswordTextBox"/>
                    <TextBox x:Name="PasswordTextBox"
                             Text="{Binding Password}"
                             PasswordChar="*"/>
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">
            <Button Content="Отмена"
                    Command="{Binding CancelCommand}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"/>
            <Button Content="Зарегистрироваться"
                    Command="{Binding RegisterCommand}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
