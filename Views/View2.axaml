<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:Alexander_Yurtaev.AvaloniaAuth.Models"
             xmlns:viewmodels="using:Alexander_Yurtaev.AvaloniaAuth.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Alexander_Yurtaev.AvaloniaAuth.Views.View2"
             x:DataType="viewmodels:View2Model"
             Classes="content-view">
    <Border Classes="dev-card">
        <Grid RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0"
                       Text="О разработчике"
                       Classes="h3"/>
            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding DeveloperDetails}"
                          Classes="dev-card-list">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"
                                    Spacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:DeveloperDetail">
                        <Border Classes="dev-card-item">
                            <Grid>
                                <TextBlock Text="{Binding Name}"
                                           Classes="label"/>
                                <TextBlock Text="{Binding Value}"
                                           Classes="value"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
