<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:Alexander_Yurtaev.AvaloniaAuth.Models"
             xmlns:viewmodels="using:Alexander_Yurtaev.AvaloniaAuth.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Alexander_Yurtaev.AvaloniaAuth.Views.View1"
             x:DataType="viewmodels:View1Model"
             Classes="content-view">
    <UserControl.DataTemplates>
        <DataTemplate DataType="models:UnAuthorizedModel">
            <Border Classes="auth_hint">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{Binding Title}"
                               Classes="h3"/>
                    <TextBlock Text="{Binding Message}"
                               Classes="p"
                               TextWrapping="WrapWithOverflow"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="models:User">
            <Border Classes="user-card">
                <StackPanel Orientation="Horizontal">
                    <Border Classes="avatar">
                        <Border.Background>
                            <ImageBrush Source="avares://Alexander_Yurtaev.AvaloniaAuth/Assets/AvatarBase.png"
                                        Stretch="UniformToFill"
                                        AlignmentX="Center"
                                        AlignmentY="Center"/>
                        </Border.Background>
                    </Border>
                    <Grid ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto,Auto,Auto"
                          Classes="user-fields">

                        <TextBlock Grid.Column="0"
                                   Grid.Row="0"
                                   Classes="label"
                                   Text="id:"/>
                        <TextBlock Grid.Column="1"
                                   Grid.Row="0"
                                   Classes="value"
                                   Text="{Binding Id}"/>

                        <TextBlock Grid.Column="0"
                                   Grid.Row="1"
                                   Classes="label"
                                   Text="email:"/>
                        <TextBlock Grid.Column="1"
                                   Grid.Row="1"
                                   Classes="value"
                                   Text="{Binding Email}"/>

                        <TextBlock Grid.Column="0"
                                   Grid.Row="2"
                                   Classes="label"
                                   Text="имя:"/>
                        <TextBlock Grid.Column="1"
                                   Grid.Row="2"
                                   Classes="value"
                                   Text="{Binding Name}"/>

                        <TextBlock Grid.Column="0"
                                   Grid.Row="3"
                                   Classes="label"
                                   Text="роль:"/>
                        <TextBlock Grid.Column="1"
                                   Grid.Row="3"
                                   Classes="value"
                                   Text="{Binding Role}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>
    <ContentControl Content="{Binding Content}"/>
</UserControl>
