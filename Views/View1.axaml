<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:Alexander_Yurtaev.AvaloniaAuth.Models"
             xmlns:viewmodels="using:Alexander_Yurtaev.AvaloniaAuth.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Alexander_Yurtaev.AvaloniaAuth.Views.View1"
             x:DataType="viewmodels:View1Model">
    <UserControl.DataTemplates>
        <DataTemplate DataType="models:UnAthorizedModel">
            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Message}"
                           TextWrapping="WrapWithOverflow"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="models:User">
            <Grid Background="LightYellow">
                <Border VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="72"
                                Height="72"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                CornerRadius="36">
                            <Border.Background>
                                <ImageBrush Source="avares://Alexander_Yurtaev.AvaloniaAuth/Assets/AvatarBase.png" 
                                            Stretch="UniformToFill" 
                                            AlignmentX="Center" 
                                            AlignmentY="Center"/>
                            </Border.Background>
                        </Border>
                        <Grid ColumnDefinitions="Auto,*"
                              RowDefinitions="Auto,Auto,Auto,Auto">

                            <TextBlock Grid.Column="0"
                                       Grid.Row="0"
                                       Text="id:"/>
                            <TextBlock Grid.Column="1"
                                       Grid.Row="0"
                                       Text="{Binding Id}"/>

                            <TextBlock Grid.Column="0"
                                       Grid.Row="1"
                                       Text="email:"/>
                            <TextBlock Grid.Column="1"
                                       Grid.Row="1"
                                       Text="{Binding Email}"/>

                            <TextBlock Grid.Column="0"
                                       Grid.Row="2"
                                       Text="имя:"/>
                            <TextBlock Grid.Column="1"
                                       Grid.Row="2"
                                       Text="{Binding Name}"/>

                            <TextBlock Grid.Column="0"
                                       Grid.Row="3"
                                       Text="роль:"/>
                            <TextBlock Grid.Column="1"
                                       Grid.Row="3"
                                       Text="{Binding Role}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.DataTemplates>
    <ContentControl Content="{Binding Content}"/>
</UserControl>
