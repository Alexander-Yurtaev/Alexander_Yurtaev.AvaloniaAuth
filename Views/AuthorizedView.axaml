<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="using:Alexander_Yurtaev.AvaloniaAuth.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Alexander_Yurtaev.AvaloniaAuth.Views.AuthorizedView"
             x:DataType="viewmodels:AuthorizedViewModel">
  <Grid RowDefinitions="Auto,Auto,*"
        Classes="auth-state">
      <Border Grid.Row="0"
                Classes="error-banner"
                IsVisible="{Binding HasErrorMessage}">
            <TextBlock Text="{Binding ErrorMessage}" />
        </Border>
      <StackPanel Grid.Row="1"
                  VerticalAlignment="Top"
                  Orientation="Vertical">
          <TextBlock Text="{Binding Title}"
                     Classes="logged-in-info strong"/>
          <TextBlock Text="{Binding Message}"
                     Classes="logged-in-info"/>
      </StackPanel>
      <Button Grid.Row="2"
              Content="Выйти"
              Command="{Binding LogoutCommand}"
              Classes="Button"
              VerticalAlignment="Bottom"/>
  </Grid>
</UserControl>
