<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="using:Alexander_Yurtaev.AvaloniaAuth.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Alexander_Yurtaev.AvaloniaAuth.Views.AuthorizedView"
             x:DataType="viewmodels:AuthorizedViewModel">
  <Grid RowDefinitions="Auto,*">
      <StackPanel Grid.Row="0"
                  VerticalAlignment="Top"
                  Orientation="Vertical">
          <TextBlock Text="{Binding Model.Title}"
                     FontWeight="Bold"
                     TextAlignment="Center"/>
          <TextBlock Text="{Binding Model.Message}"
                     TextAlignment="Center"/>
      </StackPanel>
      <Button Grid.Row="1"
              Content="Выйти"
              Command="{Binding LogoutCommand}"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"/>
  </Grid>
</UserControl>
