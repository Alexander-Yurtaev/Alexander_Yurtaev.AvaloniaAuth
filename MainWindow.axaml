<Window xmlns="https://github.com/avaloniaui"
        xmlns:converters="using:Alexander_Yurtaev.AvaloniaAuth.Converters"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:enums="using:Alexander_Yurtaev.AvaloniaAuth.Enums"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="using:Alexander_Yurtaev.AvaloniaAuth.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Alexander_Yurtaev.AvaloniaAuth.MainWindow"
        Title="Alexander_Yurtaev.AvaloniaAuth"
        x:DataType="viewmodels:MainViewModel">
    <Window.Resources>
        <converters:SelectedViewToBoolConverter x:Key="SelectedViewToBoolConv"/>
    </Window.Resources>
    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0"
                    Grid.Column="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="10">
            <ToggleButton Content="btn__View_1"
                          IsChecked="{Binding SelectedViewModel, Converter={StaticResource SelectedViewToBoolConv}, ConverterParameter={x:Static enums:SelectedViewModel.View1Model}}"/>
            <ToggleButton Content="btn__View_2"
                          IsChecked="{Binding SelectedViewModel, Converter={StaticResource SelectedViewToBoolConv}, ConverterParameter={x:Static enums:SelectedViewModel.View2Model}}"/>
        </StackPanel>
        <Grid 
            Grid.Row="1"
            ColumnDefinitions="3*,*"
            ColumnSpacing="10">
            <ContentControl Grid.Column="0" 
                            Content="{Binding ViewModel}"/>
            <ContentControl Grid.Column="1" 
                            Content="{Binding AuthViewModel}"/>
        </Grid>
    </Grid>
</Window>
