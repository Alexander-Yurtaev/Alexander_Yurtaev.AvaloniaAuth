<Window xmlns="https://github.com/avaloniaui"
        xmlns:converters="using:Alexander_Yurtaev.AvaloniaAuth.Converters"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:enums="using:Alexander_Yurtaev.AvaloniaAuth.Enums"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:Alexander_Yurtaev.AvaloniaAuth.Models"
        xmlns:viewmodels="using:Alexander_Yurtaev.AvaloniaAuth.ViewModels"
        xmlns:views="using:Alexander_Yurtaev.AvaloniaAuth.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Alexander_Yurtaev.AvaloniaAuth.MainWindow"
        Title="Alexander_Yurtaev.AvaloniaAuth"
        x:DataType="viewmodels:MainViewModel">
    <Window.DataTemplates>
        <DataTemplate DataType="viewmodels:AuthViewModel">
            <views:AuthView/>
        </DataTemplate>
        <DataTemplate DataType="viewmodels:View1Model">
            <views:View1/>
        </DataTemplate>
        <DataTemplate DataType="viewmodels:View2Model">
            <views:View2/>
        </DataTemplate>
        <DataTemplate DataType="models:SectionViewModel">
            <ToggleButton Classes="tab-btn"
                          Content="{Binding Title}"
                          IsChecked="{Binding IsChecked}"/>
        </DataTemplate>
    </Window.DataTemplates>
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Classes="main-toolbar">
            <ItemsControl Grid.Row="0"
                          Grid.Column="0"
                          ItemsSource="{Binding SectionManager.SectionsSource}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    Spacing="10"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Border>
        <Border Grid.Row="1"
                Classes="main-body">
            <Grid ColumnDefinitions="3*,*"
                  ColumnSpacing="10">
                <ContentControl Grid.Column="0"
                                Classes="content-panel-base content-panel"
                                Content="{Binding SectionManager.ViewModel}"/>
                <ContentControl Grid.Column="1"
                                Classes="content-panel-base auth-panel"
                                Content="{Binding AuthViewModel}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
