<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Alexander_Yurtaev.AvaloniaAuth.App"
             RequestedThemeVariant="Light">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <Color x:Key="PanelColor">#ffffff</Color>
        <Color x:Key="BorderColor">#d0d4dc</Color>
        <Color x:Key="TextColor">#1f2430</Color>
        <Color x:Key="PrimaryColor">#2f6fed</Color>
        <Color x:Key="MutedColor">#6b7280</Color>

        <SolidColorBrush x:Key="PanelBrush"
                         Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="BorderBrush"
                         Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="TextBrush"
                         Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="{StaticResource PrimaryColor}"/>
        <SolidColorBrush x:Key="MutedBrush"
                         Color="{StaticResource MutedColor}"/>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <Style Selector="TextBlock.h3">
            <Setter Property="Margin" Value="0 0 0 10"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Width" Value="800"/>
            <Setter Property="Height" Value="450"/>
            <Setter Property="CanResize" Value="False"/>
            <Setter Property="WindowStartupLocation" Value="CenterScreen"/>
        </Style>
        <Style Selector="Border.main-toolbar">
            <Setter Property="Padding" Value="18 12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Background" Value="#fafbfc"/>
            <Style Selector="^ ToggleButton.tab-btn">
                <Setter Property="Padding" Value="16 8"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="Background" Value="#fff"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="500"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style Selector="^:checked /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="#fff"/>
                </Style>
            </Style>
        </Style>
        <Style Selector="Border.main-body">
            <Setter Property="Padding" Value="16"/>
            <Style Selector="^ ContentControl.content-panel-base">
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Background" Value="#fff"/>
            </Style>
            <Style Selector="^ ContentControl.content-panel">
                <Setter Property="MinWidth" Value="480"/>
                <Style Selector="^ UserControl.content-view">
                    <Setter Property="Padding" Value="20"/>
                    <Style Selector="^ Border.auth_hint">
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="VerticalAlignment" Value="Top"/>
                        <Setter Property="Padding" Value="24 60"/>
                        <Style Selector="^ TextBlock.p">
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="LineHeight" Value="21"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </Style>
                    <Style Selector="^ Border.user-card">
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="VerticalAlignment" Value="Top"/>
                        <Setter Property="Padding" Value="16"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                        <Setter Property="CornerRadius" Value="8"/>
                        <Setter Property="Background" Value="#fafbfc"/>
                        <Style Selector="^ StackPanel.user-card">
                            <Setter Property="Spacing" Value="20"/>
                            <Style Selector="^ Border.avatar">
                                <Setter Property="Height" Value="72"/>
                                <Setter Property="Width" Value="72"/>
                                <Setter Property="CornerRadius" Value="36"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                            <Style Selector="^ Grid.user-fields">
                                <Setter Property="ColumnSpacing" Value="8"/>
                                <Setter Property="RowSpan" Value="6"/>
                            </Style>
                            <Style Selector="^ TextBlock">
                                <Setter Property="FontSize" Value="14"/>
                            </Style>
                            <Style Selector="^ TextBlock.label">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                <Setter Property="MinWidth" Value="60"/>
                            </Style>
                            <Style Selector="^ TextBlock.value">
                                <Setter Property="FontWeight" Value="500"/>
                            </Style>
                        </Style>
                    </Style>
                    <Style Selector="^ Border.dev-card">
                        <Setter Property="MaxWidth" Value="520"/>
                        <Setter Property="Padding" Value="24"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                        <Setter Property="CornerRadius" Value="8"/>
                        <Setter Property="Background" Value="#fafbfc"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="VerticalAlignment" Value="Top"/>
                        <Style Selector="^ ItemsControl.dev-card-list">
                            <Setter Property="Margin" Value="0"/>
                            <Style Selector="^ Border.dev-card-item">
                                <Setter Property="Padding" Value="10 6"/>
                                <Setter Property="Background" Value="#fff"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                <Setter Property="CornerRadius" Value="6"/>
                                <Style Selector="^ TextBlock.label">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                </Style>
                                <Style Selector="^ TextBlock.value">
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </Style>
                        </Style>
                    </Style>
                </Style>
            </Style>
            <Style Selector="^ ContentControl.auth-panel">
            </Style>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Application.Styles>
</Application>